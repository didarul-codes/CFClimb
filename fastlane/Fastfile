# Release lanes for CFClimb. Android is live on Google Play, so every Android lane that
# changes the store either validates first or goes to the internal track, never straight
# to production.

default_platform(:android)

platform :android do
  play = {
    json_key: ENV["PLAY_JSON_KEY"],
    package_name: "com.codeforcesvisualizer",
  }

  desc "Download the live Play listing into fastlane/metadata/android-live (read only)"
  lane :download_listing do
    download_from_play_store(play.merge(metadata_path: "fastlane/metadata/android-live"))
  end

  desc "Dry run: check the listing text and credentials without changing anything on Play"
  lane :validate_listing do
    upload_to_play_store(play.merge(
      skip_upload_aab: true, skip_upload_apk: true, skip_upload_changelogs: true,
      skip_upload_images: true, skip_upload_screenshots: true,
      validate_only: true,
    ))
  end

  desc "Upload only the listing text (title and descriptions) to the live app"
  lane :listing do
    upload_to_play_store(play.merge(
      skip_upload_aab: true, skip_upload_apk: true, skip_upload_changelogs: true,
      skip_upload_images: true, skip_upload_screenshots: true,
    ))
  end

  desc "Build a signed release bundle and upload it to the internal testing track"
  lane :internal do
    gradle(task: ":composeApp:bundleRelease")
    upload_to_play_store(play.merge(
      track: "internal",
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
    ))
  end

  desc "Promote the internal build to production as a staged rollout (default 10%)"
  lane :production do |options|
    upload_to_play_store(play.merge(
      track: "internal",
      track_promote_to: "production",
      rollout: (options[:rollout] || "0.1").to_s,
      skip_upload_aab: true, skip_upload_apk: true,
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
    ))
  end
end

platform :ios do
  private_lane :asc_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
    )
  end

  desc "Download the current App Store listing into fastlane/metadata/ios-approved (read only)"
  lane :download_listing do
    sh("bundle", "exec", "fastlane", "deliver", "download_metadata",
       "--app_identifier", "com.codeforcesvisualizer.iosApp",
       "--metadata_path", File.expand_path("metadata/ios-approved", __dir__),
       "--api_key_path", File.expand_path("asc_api_key.json", __dir__))
  end

  desc "Build with the next build number and upload to TestFlight"
  lane :beta do
    api_key = asc_key
    build = latest_testflight_build_number(api_key: api_key, initial_build_number: 4) + 1
    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      # Applies to the app and the widget extension, which must share a build number.
      xcargs: "CURRENT_PROJECT_VERSION=#{build} -allowProvisioningUpdates",
      output_directory: "build/ios",
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Upload the listing text to App Store Connect without submitting"
  lane :listing do
    deliver(
      api_key: asc_key,
      metadata_path: "fastlane/metadata/ios",
      skip_binary_upload: true, skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end
