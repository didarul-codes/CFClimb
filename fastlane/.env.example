# Copy to fastlane/.env (gitignored) and fill in. Keep the key files outside the repo.

# Google Play: service account JSON with release access to CFClimb
PLAY_JSON_KEY=/Users/you/.keys/cfclimb-play.json

# App Store Connect API key (Users and Access > Integrations)
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/Users/you/.keys/AuthKey_XXXXXXXXXX.p8
